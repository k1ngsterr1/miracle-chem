  sentQuantity      Decimal           @default(0) @db.Decimal(20, 6)
  acceptedQuantity  Decimal           @default(0) @db.Decimal(20, 6)
  returnedQuantity  Decimal           @default(0) @db.Decimal(20, 6)
  rejectedQuantity  Decimal           @default(0) @db.Decimal(20, 6)
  unit              Unit
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productMovements  ProductMovement[]

  @@unique([transferId, productLotId])
  @@index([batchId])
  @@map("lrt_transfer_items")
}

model Wagon {
