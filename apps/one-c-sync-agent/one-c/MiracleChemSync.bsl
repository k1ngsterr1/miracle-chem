// Шаблон общего модуля / внешней обработки для 1С 8.3.
// Сбор данных (клиенты, поставщики, номенклатура и проведённые поступления)
// зависит от вашей конфигурации 1С, поэтому СобратьДельтуИзменений реализуется
// в расширении с нужными справочниками и документами.

Функция ПередатьДельтуВMiracleChem(Дельта, ЛокальныйКлюч) Экспорт
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Дельта);
    ТелоЗапроса = ЗаписьJSON.Закрыть();

    // Агент доступен только на этом компьютере. Порт меняется в config.json агента.
    Соединение = Новый HTTPСоединение("127.0.0.1", 8261);
    Запрос = Новый HTTPЗапрос("/v1/delta");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-Agent-Ingest-Key", ЛокальныйКлюч);
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

    Попытка
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Исключение
        // Агент или компьютер временно недоступен: не сдвигайте курсор выгрузки.
        ВызватьИсключение "Дельта не передана локальному агенту: " + ОписаниеОшибки();
    КонецПопытки;

    Если Ответ.КодСостояния <> 202 Тогда
        ВызватьИсключение "Агент отклонил дельту: HTTP " + Строка(Ответ.КодСостояния) + " " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;

    Возврат Истина;
КонецФункции

// Обязательные поля в объекте Дельта:
// workspaceId (UUID CRM), batchId (новый и неизменный для одной выгрузки),
// generatedAt (ISO 8601), source = "1C", customers, suppliers, materials, receipts.
// После HTTP 202 агент сам обеспечит повторную отправку в CRM. Курсор 1С можно
// сдвигать после 202: агент сохраняет JSON на диск атомарно до ответа.
