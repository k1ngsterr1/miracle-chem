  @@index([workspaceId, status, producedAt])
  @@index([workspaceId, concreteGrade, producedAt])
  @@map("product_lots")
}

model ProductLotMaterialTrace {
  id               String                  @id @default(uuid()) @db.Uuid
  productLotId     String                  @db.Uuid
