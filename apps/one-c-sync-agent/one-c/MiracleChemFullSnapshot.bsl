// Общий модуль или модуль внешней обработки для Бухгалтерии для Казахстана 3.0.
// Выполнять на том же Windows-компьютере, где работает локальный OneCSyncAgent.
// 1С только читает свои данные; HTTP 202 означает, что агент сохранил полный
// снимок на диск. Сам агент затем повторяет отправку в CRM по HTTPS.
// Не вызывайте из серверного задания на другом узле: 127.0.0.1 укажет не туда.

Функция ДенежнаяСтрока(Значение)
    // JSONWriter записывает число с точкой независимо от региональных настроек.
    ЗаписьЧисла = Новый ЗаписьJSON;
    ЗаписьЧисла.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьЧисла, Значение);
    Возврат ЗаписьЧисла.Закрыть();
КонецФункции

Функция ДатаИсточника(Значение)
    // Даты документов — локальное время 1С без выдуманного UTC-смещения.
    Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция МоментUTC()
    Возврат Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";
КонецФункции

Функция ПрочитатьНабор(ТекстЗапроса, ПоляСсылок = "", ПоляЧисел = "", ПоляДат = "")
    Запрос = Новый Запрос(ТекстЗапроса);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() > 2000 Тогда
        ВызватьИсключение "Выгрузка превышает 2000 строк в одном разделе. Пакет не отправлен.";
    КонецЕсли;

    Результат = Новый Массив;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        СтрокаJSON = Новый Структура;
        Для Каждого Колонка Из Таблица.Колонки Цикл
            Имя = Колонка.Имя;
            Значение = СтрокаТаблицы[Имя];
            Если Найти("," + ПоляСсылок + ",", "," + Имя + ",") > 0 Тогда
                // Пустая аналитика или контрагент не должны обрывать всю выгрузку.
                Если ЗначениеЗаполнено(Значение) Тогда
                    Значение = Строка(Значение.УникальныйИдентификатор());
                Иначе
                    Значение = "00000000-0000-0000-0000-000000000000";
                КонецЕсли;
            ИначеЕсли Найти("," + ПоляЧисел + ",", "," + Имя + ",") > 0 Тогда
                Значение = ДенежнаяСтрока(Значение);
            ИначеЕсли Найти("," + ПоляДат + ",", "," + Имя + ",") > 0 Тогда
                Значение = ДатаИсточника(Значение);
            КонецЕсли;
            СтрокаJSON.Вставить(Имя, Значение);
        КонецЦикла;
        Результат.Добавить(СтрокаJSON);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СобратьПолныйСнимокMiracleChem() Экспорт
    Если Метаданные.Имя <> "БухгалтерияДляКазахстана" Тогда
        ВызватьИсключение "Поддерживается только Бухгалтерия для Казахстана 3.0";
    КонецЕсли;

    Снимок = Новый Структура;
    Снимок.Вставить("schemaVersion", 1);
    Снимок.Вставить("source", "1C");
    Снимок.Вставить("configuration", Метаданные.Имя);
    Снимок.Вставить("configurationVersion", Метаданные.Версия);
    Снимок.Вставить("readStartedAt", МоментUTC());
    Снимок.Вставить("consistency", "SEQUENTIAL_READ_ONLY_NOT_ACCOUNTING_CLOSE");

    Снимок.Вставить("organizations", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Н.Ссылка КАК externalId, Н.Код КАК code, Н.Наименование КАК name
        |ИЗ Справочник.Организации КАК Н УПОРЯДОЧИТЬ ПО Н.Код",
        "externalId"));

    Снимок.Вставить("counterparties", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Н.Ссылка КАК externalId, Н.Код КАК code, Н.Наименование КАК name,
        |Н.Родитель.Наименование КАК groupName, Н.ИдентификационныйКодЛичности КАК taxId,
        |Н.ПометкаУдаления КАК deleted
        |ИЗ Справочник.Контрагенты КАК Н ГДЕ НЕ Н.ЭтоГруппа УПОРЯДОЧИТЬ ПО Н.Код",
        "externalId"));

    Снимок.Вставить("materials", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Н.Ссылка КАК externalId, Н.Код КАК code, Н.Наименование КАК name,
        |Н.Родитель.Наименование КАК groupName,
        |Н.БазоваяЕдиницаИзмерения.Ссылка КАК unitId,
        |Н.БазоваяЕдиницаИзмерения.Наименование КАК unitName,
        |Н.Услуга КАК service, Н.ПометкаУдаления КАК deleted
        |ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ЭтоГруппа УПОРЯДОЧИТЬ ПО Н.Код",
        "externalId,unitId"));

    Снимок.Вставить("receipts", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Т.Ссылка КАК documentId, Т.НомерСтроки КАК lineNumber,
        |Т.Ссылка.Номер КАК number, Т.Ссылка.Дата КАК receivedAt,
        |Т.Ссылка.Проведен КАК posted, Т.Ссылка.ПометкаУдаления КАК deleted,
        |Т.Ссылка.Организация КАК organizationId, Т.Ссылка.Контрагент КАК supplierId,
        |Т.Ссылка.Склад КАК warehouseId, Т.Номенклатура КАК materialId,
        |Т.ЕдиницаИзмерения КАК unitId, Т.ЕдиницаИзмерения.Наименование КАК unitName,
        |Т.Коэффициент КАК coefficient, Т.Количество КАК quantity, Т.Цена КАК unitPrice,
        |Т.Сумма КАК amount, Т.СуммаНДС КАК vatAmount,
        |Т.Ссылка.СуммаВключаетНДС КАК amountIncludesVat,
        |Т.Ссылка.НДСВключенВСтоимость КАК vatInCost,
        |Т.Ссылка.ВалютаДокумента.Наименование КАК currencyName,
        |Т.Ссылка.КурсВзаиморасчетов КАК exchangeRate,
        |Т.Ссылка.КратностьВзаиморасчетов КАК exchangeMultiplicity
        |ИЗ Документ.ПоступлениеТоваровУслуг.Товары КАК Т
        |УПОРЯДОЧИТЬ ПО Т.Ссылка.Дата, Т.Ссылка, Т.НомерСтроки",
        "documentId,organizationId,supplierId,warehouseId,materialId,unitId",
        "coefficient,quantity,unitPrice,amount,vatAmount,exchangeRate,exchangeMultiplicity",
        "receivedAt"));

    // Накопительный регистр — только контрольный: в этой базе он не показывает всё сырьё.
    Снимок.Вставить("balances", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 О.Организация КАК organizationId, О.Склад КАК warehouseId,
        |О.Товар КАК materialId, СУММА(О.КоличествоОстаток) КАК quantity
        |ИЗ РегистрНакопления.ТоварыОрганизацийБУ.Остатки КАК О
        |СГРУППИРОВАТЬ ПО О.Организация, О.Склад, О.Товар",
        "organizationId,warehouseId,materialId", "quantity"));

    // Склад и балансовая стоимость — счета 1310/1320/1330.
    Снимок.Вставить("accountingInventory", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 О.Организация КАК organizationId, О.Счет.Код КАК accountCode,
        |О.Субконто1 КАК materialId, О.Субконто2 КАК warehouseId,
        |О.КоличествоОстатокДт КАК quantityDebit, О.КоличествоОстатокКт КАК quantityCredit,
        |О.СуммаОстатокДт КАК amountDebit, О.СуммаОстатокКт КАК amountCredit
        |ИЗ РегистрБухгалтерии.Типовой.Остатки КАК О
        |ГДЕ О.Счет.Код = ""1310"" ИЛИ О.Счет.Код = ""1320"" ИЛИ О.Счет.Код = ""1330""",
        "organizationId,materialId,warehouseId",
        "quantityDebit,quantityCredit,amountDebit,amountCredit"));

    // Дебиторка по контрагенту и договору — счёт 1210.
    Снимок.Вставить("receivables", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 О.Организация КАК organizationId,
        |О.Субконто1 КАК counterpartyId, О.Субконто2 КАК contractId,
        |О.СуммаОстатокДт КАК amountDebit, О.СуммаОстатокКт КАК amountCredit
        |ИЗ РегистрБухгалтерии.Типовой.Остатки КАК О ГДЕ О.Счет.Код = ""1210""",
        "organizationId,counterpartyId,contractId", "amountDebit,amountCredit"));

    Снимок.Вставить("sales", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Д.Ссылка КАК externalId, Д.Номер КАК number,
        |Д.Дата КАК documentAt, Д.Организация КАК organizationId,
        |Д.Контрагент КАК counterpartyId, Д.СуммаДокумента КАК amount,
        |Д.Проведен КАК posted, Д.ПометкаУдаления КАК deleted
        |ИЗ Документ.РеализацияТоваровУслуг КАК Д УПОРЯДОЧИТЬ ПО Д.Дата, Д.Ссылка",
        "externalId,organizationId,counterpartyId", "amount", "documentAt"));

    Снимок.Вставить("saleLines", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Т.Ссылка КАК documentId, Т.НомерСтроки КАК lineNumber,
        |Т.Номенклатура КАК materialId, Т.ЕдиницаИзмерения КАК unitId,
        |Т.ЕдиницаИзмерения.Наименование КАК unitName, Т.Количество КАК quantity,
        |Т.Цена КАК unitPrice, Т.Сумма КАК amount, Т.СуммаНДС КАК vatAmount
        |ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Т
        |УПОРЯДОЧИТЬ ПО Т.Ссылка, Т.НомерСтроки",
        "documentId,materialId,unitId", "quantity,unitPrice,amount,vatAmount"));

    Снимок.Вставить("invoices", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Д.Ссылка КАК externalId, Д.Номер КАК number,
        |Д.Дата КАК documentAt, Д.Организация КАК organizationId,
        |Д.Контрагент КАК counterpartyId, Д.СуммаДокумента КАК amount,
        |Д.Проведен КАК posted, Д.ПометкаУдаления КАК deleted
        |ИЗ Документ.СчетНаОплатуПокупателю КАК Д УПОРЯДОЧИТЬ ПО Д.Дата, Д.Ссылка",
        "externalId,organizationId,counterpartyId", "amount", "documentAt"));

    Снимок.Вставить("invoiceLines", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Т.Ссылка КАК documentId, Т.НомерСтроки КАК lineNumber,
        |Т.Номенклатура КАК materialId, Т.ЕдиницаИзмерения КАК unitId,
        |Т.ЕдиницаИзмерения.Наименование КАК unitName, Т.Количество КАК quantity,
        |Т.Цена КАК unitPrice, Т.Сумма КАК amount, Т.СуммаНДС КАК vatAmount
        |ИЗ Документ.СчетНаОплатуПокупателю.Товары КАК Т
        |УПОРЯДОЧИТЬ ПО Т.Ссылка, Т.НомерСтроки",
        "documentId,materialId,unitId", "quantity,unitPrice,amount,vatAmount"));

    Снимок.Вставить("incomingPayments", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Д.Ссылка КАК externalId, Д.Номер КАК number,
        |Д.Дата КАК documentAt, Д.Организация КАК organizationId,
        |Д.Контрагент КАК counterpartyId, Д.СуммаДокумента КАК amount,
        |Д.ВалютаДокумента.Наименование КАК currencyName,
        |Д.НазначениеПлатежа КАК purpose, Д.Проведен КАК posted,
        |Д.ПометкаУдаления КАК deleted
        |ИЗ Документ.ПлатежноеПоручениеВходящее КАК Д
        |УПОРЯДОЧИТЬ ПО Д.Дата, Д.Ссылка",
        "externalId,organizationId,counterpartyId", "amount", "documentAt"));

    Снимок.Вставить("outgoingPayments", ПрочитатьНабор(
        "ВЫБРАТЬ ПЕРВЫЕ 2001 Д.Ссылка КАК externalId, Д.Номер КАК number,
        |Д.Дата КАК documentAt, Д.Организация КАК organizationId,
        |Д.Контрагент КАК counterpartyId, Д.СуммаДокумента КАК amount,
        |Д.ВалютаДокумента.Наименование КАК currencyName,
        |Д.НазначениеПлатежа КАК purpose, Д.Проведен КАК posted,
        |Д.ПометкаУдаления КАК deleted
        |ИЗ Документ.ПлатежноеПоручениеИсходящее КАК Д
        |УПОРЯДОЧИТЬ ПО Д.Дата, Д.Ссылка",
        "externalId,organizationId,counterpartyId", "amount", "documentAt"));

    Снимок.Вставить("generatedAt", МоментUTC());
    Возврат Снимок;
КонецФункции

Функция ПередатьПолныйСнимокВMiracleChem(ИДРабочейОбласти, ИДИсточника, ИДОрганизации, ЛокальныйКлюч) Экспорт
    Если ПустаяСтрока(ИДРабочейОбласти) Или ПустаяСтрока(ИДИсточника)
        Или ПустаяСтрока(ИДОрганизации) Или ПустаяСтрока(ЛокальныйКлюч) Тогда
        ВызватьИсключение "Заполните GUID CRM, GUID источника, GUID организации и локальный ключ";
    КонецЕсли;

    Снимок = СобратьПолныйСнимокMiracleChem();
    // Запросы ниже собирают данные всей файловой базы. Пока нет безопасной
    // построчной фильтрации по организации, не передаём смешанный контур.
    Если Снимок.organizations.Количество() <> 1 Тогда
        ВызватьИсключение "В базе несколько организаций. Передача остановлена до разделения снимка по организациям.";
    КонецЕсли;
    ОрганизацияНайдена = Ложь;
    Для Каждого Организация Из Снимок.organizations Цикл
        Если НРег(Организация.externalId) = НРег(ИДОрганизации) Тогда
            ОрганизацияНайдена = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если Не ОрганизацияНайдена Тогда
        ВызватьИсключение "GUID организации отсутствует в текущей базе 1С";
    КонецЕсли;

    Пакет = Новый Структура;
    Пакет.Вставить("kind", "FULL_SNAPSHOT");
    Пакет.Вставить("source", "1C");
    Пакет.Вставить("workspaceId", ИДРабочейОбласти);
    Пакет.Вставить("sourceInstanceId", ИДИсточника);
    Пакет.Вставить("organizationExternalId", ИДОрганизации);
    Пакет.Вставить("batchId", Строка(Новый УникальныйИдентификатор));
    Пакет.Вставить("generatedAt", Снимок.generatedAt);
    Пакет.Вставить("snapshot", Снимок);

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Пакет);
    Тело = Запись.Закрыть();
    // Даже четырёхбайтовый UTF-8 укладывается в лимит приёма API (10 МиБ).
    // Не отправляем и не обрезаем неполный снимок: для большой базы нужна
    // постраничная передача с общей фиксацией полного набора.
    Если СтрДлина(Тело) > 2000000 Тогда
        ВызватьИсключение "Полный снимок превышает безопасный размер пакета. Нужна постраничная выгрузка; данные не отправлены.";
    КонецЕсли;
    Соединение = Новый HTTPСоединение("127.0.0.1", 8261);
    Запрос = Новый HTTPЗапрос("/v1/snapshot");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-Agent-Ingest-Key", ЛокальныйКлюч);
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);

    Попытка
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Исключение
        ВызватьИсключение "Агент не принял снимок 1С; повторите запуск. " + ОписаниеОшибки();
    КонецПопытки;
    Если Ответ.КодСостояния <> 202 Тогда
        ВызватьИсключение "Агент отклонил снимок: HTTP " + Строка(Ответ.КодСостояния)
            + " " + Ответ.ПолучитьТелоКакСтроку();
    КонецЕсли;
    Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

// Вызывается кнопкой внешней обработки. Настройки остаются на Windows и не
// встраиваются в .epf: у разных рабочих контуров разные GUID и локальные ключи.
Функция ПередатьПолныйСнимокИзЛокальныхНастроек() Экспорт
    Путь = "C:\ProgramData\MiracleChem\OneCSyncAgent\one-c-exchange.json";
    ФайлНастроек = Новый Файл(Путь);
    Если Не ФайлНастроек.Существует() Тогда
        ВызватьИсключение "Не найден файл настроек обмена 1С: " + Путь;
    КонецЕсли;

    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Путь);
    Настройки = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат ПередатьПолныйСнимокВMiracleChem(
        Настройки.workspaceId,
        Настройки.sourceInstanceId,
        Настройки.organizationExternalId,
        Настройки.localIngestKey);
КонецФункции
