model AccountingDocument {
  id                 String                   @id @default(uuid()) @db.Uuid
  workspaceId        String                   @db.Uuid
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number             String
  type               AccountingDocumentType
  status             AccountingDocumentStatus @default(DRAFT)
  documentAt         DateTime
  dueAt              DateTime?
  issuedAt           DateTime?
  paidAt             DateTime?
  counterparty       String
  counterpartyTaxId  String?
  customerId         String?                  @db.Uuid
  customer           Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  basis              String?
  subtotal           Decimal                  @db.Decimal(20, 2)
  vatRate            Decimal                  @default(0) @db.Decimal(8, 4)
  vatAmount          Decimal                  @default(0) @db.Decimal(20, 2)
  totalAmount        Decimal                  @db.Decimal(20, 2)
