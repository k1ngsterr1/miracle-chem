{
  "name": "@betonflow/one-c-sync-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows outbox agent for synchronizing an offline 1C installation with Miracle Chem",
  "bin": {
    "miracle-chem-1c-agent": "dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:win": "npm run build && node scripts/package-windows.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
