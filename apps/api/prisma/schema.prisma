  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  items              AccountingDocumentItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, type, status, documentAt])
  @@index([workspaceId, counterparty, documentAt])
  @@index([transferId])
  @@index([expenseId])
  @@map("accounting_documents")
}

model AccountingDocumentItem {
  id          String             @id @default(uuid()) @db.Uuid
  documentId  String             @db.Uuid
