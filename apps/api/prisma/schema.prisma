generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIRECTOR
  MANAGER
  ACCOUNTANT
  TECHNOLOGIST
  OPERATOR
  STOREKEEPER
  QUALITY_MANAGER
  LRT_RECEIVER
  VIEWER
}

enum MaterialType {
  CEMENT
  WATER
  SAND
  AGGREGATE
  CHEMICAL_ADDITIVE
  REAGENT
  OTHER
}

enum Unit {
  G
  KG
  T
  ML
  L
  M3
  PCS
  M
  PAIR
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FormulaRoundingMode {
  HALF_UP
  UP
  DOWN
}

enum ProductionBatchStatus {
  PLANNED
  PREPARATION
  IN_PROGRESS
  COMPLETED
  PARTIALLY_TRANSFERRED
  FULLY_TRANSFERRED
  CANCELLED
  REJECTED
}

enum MaterialMovementType {
  RECEIPT
  RESERVATION
  RESERVATION_RELEASE
  CONSUMPTION
  RETURN
  LOSS
  ADJUSTMENT
}

enum ProductLotStatus {
  AVAILABLE
  PARTIALLY_DISPATCHED
  DEPLETED
  BLOCKED
  REJECTED
}

enum ProductMovementType {
  PRODUCTION
  LRT_DISPATCH
  LRT_RETURN
  WRITEOFF
  REJECT
  OTHER_SHIPMENT
  ADJUSTMENT
}

enum LrtTransferStatus {
  DRAFT
  PREPARED
  SENT
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  CANCELLED
}

enum WagonStatus {
  EMPTY
  LOADING
  LOADED
  IN_TRANSIT
  AT_DESTINATION
  UNLOADING
  RETURNING
  MAINTENANCE
}

enum ExpenseCategory {
  RAW_MATERIALS
  LOGISTICS
  UTILITIES
  MAINTENANCE
  SALARY
  TAXES
  RENT
  LABORATORY
  OTHER
}

enum ExpenseCostCenter {
  PRODUCTION
  WAREHOUSE
  LOGISTICS
  LABORATORY
  ADMINISTRATION
  OTHER
}

enum ExpensePaymentMethod {
  BANK_TRANSFER
  CASH
  CORPORATE_CARD
  OFFSET
  OTHER
}

enum ExpenseStatus {
  RECORDED
  CANCELLED
}

enum AccountingDocumentType {
  WAYBILL
  PAYMENT_INVOICE
  COMPLETION_ACT
  POWER_OF_ATTORNEY
}

enum AccountingDocumentStatus {
  DRAFT
  PENDING_DIRECTOR_APPROVAL
  PENDING_ACCOUNTANT_APPROVAL
  ISSUED
  PAID
  CANCELLED
}

enum QualityCheckStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  APPLIED
  CANCELLED
}

enum AdjustmentTargetType {
  MATERIAL_LOT
  PRODUCTION_BATCH
  PRODUCT_LOT
  LRT_TRANSFER
}

enum AuditEntityType {
  WORKSPACE
  USER
  PRODUCTION_LINE
  MATERIAL
  MATERIAL_LOT
  PURCHASE_BATCH
  RECIPE
  RECIPE_VERSION
  FORMULA
  PRODUCTION_BATCH
  PRODUCT_LOT
  LRT_TRANSFER
  WAGON
  EXPENSE
  ACCOUNTING_DOCUMENT
  CUSTOMER
  CUSTOMER_CONCRETE_RECIPE
  QUALITY_CHECK
  ADJUSTMENT
  ONE_C_SYNC
}

enum OneCSyncRunStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum OneCSyncReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OneCSyncEntityType {
  CUSTOMER
  SUPPLIER
  MATERIAL
  PURCHASE_RECEIPT
  ACCOUNTING_DOCUMENT
}

model Workspace {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  timezone                String                   @default("Asia/Almaty")
  currency                String                   @default("KZT") @db.VarChar(3)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  companyProfile          CompanyProfile?
  productionLines         ProductionLine[]
  productionTanks         ProductionTank[]
  suppliers               Supplier[]
  materials               Material[]
  materialPrices          MaterialPriceHistory[]
  materialLots            MaterialLot[]
  purchaseBatches         PurchaseBatch[]
  recipes                 Recipe[]
  recipeVersions          RecipeVersion[]
  formulas                Formula[]
  formulaVersions         FormulaVersion[]
  batches                 ProductionBatch[]
  productLots             ProductLot[]
  lrtTransfers            LrtTransfer[]
  wagons                  Wagon[]
  wagonEvents             WagonLocationEvent[]
  expenses                Expense[]
  accountingDocuments     AccountingDocument[]
  customers               Customer[]
  customerConcreteRecipes CustomerConcreteRecipe[]
  adjustments             AdjustmentDocument[]
  auditLogs               AuditLog[]
  idempotency             IdempotencyRecord[]
  oneCSyncRuns            OneCSyncRun[]
  oneCExternalReferences  OneCExternalReference[]
  oneCSyncReviews         OneCSyncReview[]
  oneCSourceSnapshots     OneCSourceSnapshot[]
  oneCArchiveImports      OneCArchiveImport[]

  @@map("workspaces")
}

model OneCSyncRun {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source           String            @default("1C") @db.VarChar(40)
  batchId          String            @db.VarChar(160)
  generatedAt      DateTime
  status           OneCSyncRunStatus @default(PROCESSING)
  summary          Json?
  error            Json?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?

  @@unique([workspaceId, source, batchId])
  @@index([workspaceId, startedAt])
  @@map("one_c_sync_runs")
}

model OneCExternalReference {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @db.Uuid
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source          String             @default("1C") @db.VarChar(40)
  entityType      OneCSyncEntityType
  externalId      String             @db.VarChar(200)
  internalId      String             @db.Uuid
  sourceUpdatedAt DateTime
  payloadHash     String             @db.VarChar(64)
  lastSyncedAt    DateTime           @default(now())

  @@unique([workspaceId, source, entityType, externalId])
  @@index([workspaceId, entityType, internalId])
  @@map("one_c_external_references")
}

model OneCSyncReview {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @db.Uuid
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source         String               @default("1C") @db.VarChar(40)
  entityType     OneCSyncEntityType
  externalId     String               @db.VarChar(200)
  payload        Json
  reason         String               @db.Text
  status         OneCSyncReviewStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   String?              @db.Uuid
  resolutionNote String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([workspaceId, source, entityType, externalId])
  @@index([workspaceId, status, createdAt])
  @@map("one_c_sync_reviews")
}

model OneCSourceSnapshot {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @db.Uuid
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceInstanceId       String    @db.Uuid
  organizationExternalId String    @db.Uuid
  generatedAt            DateTime
  sha256                 String    @db.VarChar(64)
  payload                Json
  createdAt              DateTime  @default(now())

  @@unique([workspaceId, sourceInstanceId, sha256])
  @@index([workspaceId, generatedAt])
  @@map("one_c_source_snapshots")
}

model OneCArchiveImport {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceInstanceId   String              @db.Uuid
  archiveId          String              @db.VarChar(64)
  configuration      String              @db.VarChar(160)
  configurationVersion String            @db.VarChar(80)
  readStartedAt      DateTime
  generatedAt        DateTime
  manifestSha256     String              @db.VarChar(64)
  manifest           Json
  status             String              @default("STAGING") @db.VarChar(20)
  encryptedBytes     BigInt              @default(0)
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  chunks             OneCArchiveChunk[]

  @@unique([workspaceId, sourceInstanceId, archiveId])
  @@index([workspaceId, status, generatedAt])
  @@map("one_c_archive_imports")
}

model OneCArchiveChunk {
  id             String            @id @default(uuid()) @db.Uuid
  importId       String            @db.Uuid
  archiveImport  OneCArchiveImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  collectionKey  String            @db.VarChar(512)
  chunkIndex     Int
  rowCount       Int
  sha256         String            @db.VarChar(64)
  encryptedData  Bytes             @db.ByteA
  createdAt      DateTime          @default(now())

  @@unique([importId, collectionKey, chunkIndex])
  @@index([importId, collectionKey])
  @@map("one_c_archive_chunks")
}

model CompanyProfile {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @unique @db.Uuid
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legalName         String?
  taxId             String?
  address           String?
  phone             String?
  email             String?
  bankName          String?
  iban              String?
  bic               String?
  directorName      String?
  accountantName    String?
  signatoryName     String?
  signatoryPosition String?
  documentFooter    String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("company_profiles")
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  workspaceId                String               @db.Uuid
  workspace                  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                       String
  email                      String
  passwordHash               String?
  role                       UserRole
  active                     Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  operatedBatches            ProductionBatch[]    @relation("BatchOperator")
  sentTransfers              LrtTransfer[]        @relation("TransferSender")
  receivedTransfers          LrtTransfer[]        @relation("TransferReceiver")
  performedChecks            QualityCheck[]
  approvedAdjustments        AdjustmentDocument[] @relation("AdjustmentApprover")
  createdAdjustments         AdjustmentDocument[] @relation("AdjustmentCreator")
  auditLogs                  AuditLog[]
  wagonLocationEvents        WagonLocationEvent[]
  createdExpenses            Expense[]            @relation("ExpenseCreator")
  cancelledExpenses          Expense[]            @relation("ExpenseCanceller")
  createdAccountingDocuments AccountingDocument[] @relation("AccountingDocumentCreator")

  @@unique([workspaceId, email])
  @@index([workspaceId, role, active])
  @@map("users")
}

model ProductionLine {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @db.Uuid
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  name         String
  capacity     Decimal           @db.Decimal(20, 6)
  capacityUnit Unit              @default(M3)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  batches      ProductionBatch[]
  tanks        ProductionTank[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@map("production_lines")
}

model ProductionTank {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productionLineId String            @db.Uuid
  productionLine   ProductionLine    @relation(fields: [productionLineId], references: [id], onDelete: Restrict)
  code             String
  name             String
  capacity         Decimal?          @db.Decimal(20, 6)
  capacityUnit     Unit              @default(M3)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  batches          ProductionBatch[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@index([productionLineId, active])
  @@map("production_tanks")
}

model Supplier {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  taxId        String?
  contact      String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  materialLots MaterialLot[]

  @@unique([workspaceId, name])
  @@map("suppliers")
}

model Material {
  id                String                     @id @default(uuid()) @db.Uuid
  workspaceId       String                     @db.Uuid
  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code              String
  name              String
  type              MaterialType
  baseUnit          Unit
  densityKgPerM3    Decimal?                   @db.Decimal(20, 6)
  costPerBaseUnit   Decimal                    @db.Decimal(20, 4)
  currency          String                     @default("KZT") @db.VarChar(3)
  currentStock      Decimal                    @default(0) @db.Decimal(20, 6)
  reservedStock     Decimal                    @default(0) @db.Decimal(20, 6)
  minimumStock      Decimal                    @default(0) @db.Decimal(20, 6)
  active            Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  lots              MaterialLot[]
  priceHistory      MaterialPriceHistory[]
  recipeComponents  RecipeComponent[]
  formulaComponents AdditiveFormulaComponent[]
  batchComponents   BatchComponent[]

  @@unique([workspaceId, code])
  @@index([workspaceId, type, active])
  @@index([workspaceId, currentStock, minimumStock])
  @@map("materials")
}

model MaterialPriceHistory {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  materialId       String    @db.Uuid
  material         Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  pricePerBaseUnit Decimal   @db.Decimal(20, 4)
  currency         String    @default("KZT") @db.VarChar(3)
  effectiveAt      DateTime
  source           String    @db.VarChar(40)
  referenceId      String?   @db.Uuid
  note             String?
  createdAt        DateTime  @default(now())

  @@index([workspaceId, materialId, effectiveAt])
  @@index([referenceId])
  @@map("material_price_history")
}

model MaterialLot {
  id                String                    @id @default(uuid()) @db.Uuid
  workspaceId       String                    @db.Uuid
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  materialId        String                    @db.Uuid
  material          Material                  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  purchaseBatchId   String?                   @db.Uuid
  purchaseBatch     PurchaseBatch?            @relation(fields: [purchaseBatchId], references: [id], onDelete: SetNull)
  supplierId        String?                   @db.Uuid
  supplier          Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lotNumber         String
  receivedAt        DateTime
  expiresAt         DateTime?
  certificateNumber String?
  certificateUrl    String?
  initialQuantity   Decimal                   @db.Decimal(20, 6)
  availableQuantity Decimal                   @db.Decimal(20, 6)
  reservedQuantity  Decimal                   @default(0) @db.Decimal(20, 6)
  unit              Unit
  unitCost          Decimal                   @db.Decimal(20, 4)
  currency          String                    @default("KZT") @db.VarChar(3)
  densityKgPerM3    Decimal?                  @db.Decimal(20, 6)
  qualitySnapshot   Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  movements         MaterialMovement[]
  allocations       BatchMaterialAllocation[]
  attachments       Attachment[]

  @@unique([workspaceId, materialId, lotNumber])
  @@index([workspaceId, materialId, expiresAt])
  @@index([workspaceId, availableQuantity])
  @@index([purchaseBatchId])
  @@map("material_lots")
}

model PurchaseBatch {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number          String
  receivedAt      DateTime
  recipeVersionId String?        @db.Uuid
  recipeVersion   RecipeVersion? @relation(fields: [recipeVersionId], references: [id], onDelete: SetNull)
  targetSalePrice Decimal?       @db.Decimal(20, 4)
  currency        String         @default("KZT") @db.VarChar(3)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  materialLots    MaterialLot[]

  @@unique([workspaceId, number])
  @@index([workspaceId, receivedAt])
  @@index([recipeVersionId])
  @@map("purchase_batches")
}

model Recipe {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?         @db.Uuid
  customer    Customer?       @relation("CustomerProductionRecipes", fields: [customerId], references: [id], onDelete: Restrict)
  code        String
  name        String
  status      RecipeStatus    @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    RecipeVersion[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@index([workspaceId, customerId, status])
  @@map("recipes")
}

model RecipeVersion {
  id                     String            @id @default(uuid()) @db.Uuid
  workspaceId            String            @db.Uuid
  workspace              Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipeId               String            @db.Uuid
  recipe                 Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version                Int
  concreteGrade          String
  baseBatchVolume        Decimal           @db.Decimal(20, 6)
  volumeUnit             Unit              @default(M3)
  waterCementRatio       Decimal?          @db.Decimal(12, 6)
  plannedYield           Decimal           @db.Decimal(20, 6)
  yieldUnit              Unit              @default(M3)
  technologyInstructions String            @db.Text
  snapshotHash           String            @db.VarChar(64)
  publishedAt            DateTime?
  createdAt              DateTime          @default(now())
  components             RecipeComponent[]
  batches                ProductionBatch[]
  purchaseBatches        PurchaseBatch[]

  @@unique([recipeId, version])
  @@index([workspaceId, concreteGrade])
  @@map("recipe_versions")
}

model RecipeComponent {
  id                      String        @id @default(uuid()) @db.Uuid
  recipeVersionId         String        @db.Uuid
  recipeVersion           RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  materialId              String        @db.Uuid
  material                Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  normPerM3               Decimal       @db.Decimal(20, 6)
  unit                    Unit
  allowedDeviationPercent Decimal       @default(0) @db.Decimal(12, 6)
  moisturePercent         Decimal       @default(0) @db.Decimal(12, 6)
  absorptionPercent       Decimal       @default(0) @db.Decimal(12, 6)
  position                Int           @default(0)
  createdAt               DateTime      @default(now())

  @@unique([recipeVersionId, materialId])
  @@index([recipeVersionId, position])
  @@map("recipe_components")
}

model Formula {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    FormulaVersion[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@map("formulas")
}

model FormulaVersion {
  id                      String                     @id @default(uuid()) @db.Uuid
  workspaceId             String                     @db.Uuid
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formulaId               String                     @db.Uuid
  formula                 Formula                    @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  version                 Int
  expression              String                     @db.Text
  variables               Json
  precision               Int                        @default(3)
  roundingMode            FormulaRoundingMode        @default(HALF_UP)
  dosagePercent           Decimal?                   @db.Decimal(12, 6)
  publishedAt             DateTime?
  createdAt               DateTime                   @default(now())
  calculations            FormulaCalculationLog[]
  components              AdditiveFormulaComponent[]
  customerConcreteRecipes CustomerConcreteRecipe[]

  @@unique([formulaId, version])
  @@map("formula_versions")
}

model Customer {
  id              String                   @id @default(uuid()) @db.Uuid
  workspaceId     String                   @db.Uuid
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  taxId           String?
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  contractNumber  String?
  contractSignedAt DateTime?
  contractValidUntil DateTime?
  paymentTermDays Int?
  creditLimit     Decimal?                 @db.Decimal(20, 2)
  notes           String?                  @db.Text
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  concreteRecipes CustomerConcreteRecipe[]
  productionRecipes Recipe[]               @relation("CustomerProductionRecipes")
  transfers        LrtTransfer[]           @relation("CustomerTransfers")
  accountingDocuments AccountingDocument[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active])
  @@index([workspaceId, contractValidUntil])
  @@map("customers")
}

model CustomerConcreteRecipe {
  id                       String                      @id @default(uuid()) @db.Uuid
  workspaceId              String                      @db.Uuid
  workspace                Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId               String                      @db.Uuid
  customer                 Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                     String
  concreteGrade            String
  basisVolume              Decimal                     @default(1) @db.Decimal(18, 6)
  basisUnit                Unit                        @default(M3)
  binderMassKg             Decimal                     @db.Decimal(18, 6)
  additiveFormulaVersionId String                      @db.Uuid
  additiveFormulaVersion   FormulaVersion              @relation(fields: [additiveFormulaVersionId], references: [id], onDelete: Restrict)
  additiveDosagePercent    Decimal                     @db.Decimal(12, 6)
  notes                    String?                     @db.Text
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  components               CustomerConcreteComponent[]

  @@unique([customerId, name])
  @@index([workspaceId, customerId])
  @@index([additiveFormulaVersionId])
  @@map("customer_concrete_recipes")
}

model CustomerConcreteComponent {
  id                       String                 @id @default(uuid()) @db.Uuid
  customerConcreteRecipeId String                 @db.Uuid
  customerConcreteRecipe   CustomerConcreteRecipe @relation(fields: [customerConcreteRecipeId], references: [id], onDelete: Cascade)
  name                     String
  quantity                 Decimal                @db.Decimal(18, 6)
  unit                     Unit
  position                 Int                    @default(0)
  note                     String?
  createdAt                DateTime               @default(now())

  @@unique([customerConcreteRecipeId, name])
  @@index([customerConcreteRecipeId, position])
  @@map("customer_concrete_components")
}

model AdditiveFormulaComponent {
  id               String         @id @default(uuid()) @db.Uuid
  formulaVersionId String         @db.Uuid
  formulaVersion   FormulaVersion @relation(fields: [formulaVersionId], references: [id], onDelete: Cascade)
  materialId       String         @db.Uuid
  material         Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  percentage       Decimal        @db.Decimal(12, 6)
  position         Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([formulaVersionId, materialId])
  @@index([formulaVersionId, position])
  @@map("additive_formula_components")
}

model FormulaCalculationLog {
  id               String           @id @default(uuid()) @db.Uuid
  formulaVersionId String           @db.Uuid
  formulaVersion   FormulaVersion   @relation(fields: [formulaVersionId], references: [id], onDelete: Restrict)
  batchId          String?          @db.Uuid
  batch            ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  input            Json
  resultValue      Decimal          @db.Decimal(30, 12)
  resultUnit       Unit?
  trace            Json
  calculatedAt     DateTime         @default(now())

  @@index([batchId, calculatedAt])
  @@map("formula_calculation_logs")
}

model ProductionBatch {
  id                    String                  @id @default(uuid()) @db.Uuid
  workspaceId           String                  @db.Uuid
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number                String
  status                ProductionBatchStatus   @default(PLANNED)
  scheduledAt           DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  recipeVersionId       String                  @db.Uuid
  recipeVersion         RecipeVersion           @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  recipeSnapshot        Json
  formulaSnapshot       Json
  concreteGrade         String
  plannedVolume         Decimal                 @db.Decimal(20, 6)
  plannedVolumeUnit     Unit                    @default(M3)
  actualVolume          Decimal?                @db.Decimal(20, 6)
  actualVolumeUnit      Unit                    @default(M3)
  plannedOutput         Decimal                 @db.Decimal(20, 6)
  plannedOutputUnit     Unit                    @default(M3)
  actualOutput          Decimal?                @db.Decimal(20, 6)
  actualOutputUnit      Unit                    @default(M3)
  goodOutput            Decimal?                @db.Decimal(20, 6)
  rejectedOutput        Decimal                 @default(0) @db.Decimal(20, 6)
  technologicalLoss     Decimal                 @default(0) @db.Decimal(20, 6)
  sentToLrt             Decimal                 @default(0) @db.Decimal(20, 6)
  availableOutput       Decimal                 @default(0) @db.Decimal(20, 6)
  outputAccountingUnit  Unit                    @default(M3)
  totalCost             Decimal                 @default(0) @db.Decimal(20, 4)
  costPerOutputUnit     Decimal                 @default(0) @db.Decimal(20, 4)
  currency              String                  @default("KZT") @db.VarChar(3)
  operatorId            String                  @db.Uuid
  operator              User                    @relation("BatchOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  productionLineId      String                  @db.Uuid
  productionLine        ProductionLine          @relation(fields: [productionLineId], references: [id], onDelete: Restrict)
  productionTankId      String?                 @db.Uuid
  productionTank        ProductionTank?         @relation(fields: [productionTankId], references: [id], onDelete: SetNull)
  qualitySummary        Json?
  comments              String?                 @db.Text
  negativeStockOverride Boolean                 @default(false)
  lockedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  components            BatchComponent[]
  materialMovements     MaterialMovement[]
  productLots           ProductLot[]
  formulaCalculations   FormulaCalculationLog[]
  qualityChecks         QualityCheck[]
  lrtTransferItems      LrtTransferItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, productionLineId, scheduledAt])
  @@index([workspaceId, productionTankId, scheduledAt])
  @@index([workspaceId, operatorId, scheduledAt])
  @@map("production_batches")
}

model BatchComponent {
  id                      String                    @id @default(uuid()) @db.Uuid
  batchId                 String                    @db.Uuid
  batch                   ProductionBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialId              String                    @db.Uuid
  material                Material                  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialNameSnapshot    String
  materialTypeSnapshot    MaterialType
  plannedQuantity         Decimal                   @db.Decimal(20, 6)
  plannedUnit             Unit
  reservedQuantity        Decimal                   @default(0) @db.Decimal(20, 6)
  reservedUnit            Unit
  actualQuantity          Decimal                   @default(0) @db.Decimal(20, 6)
  actualUnit              Unit
  returnedQuantity        Decimal                   @default(0) @db.Decimal(20, 6)
  returnedUnit            Unit
  lossQuantity            Decimal                   @default(0) @db.Decimal(20, 6)
  lossUnit                Unit
  deviationQuantity       Decimal                   @default(0) @db.Decimal(20, 6)
  deviationUnit           Unit
  deviationPercent        Decimal                   @default(0) @db.Decimal(12, 6)
  allowedDeviationPercent Decimal                   @default(0) @db.Decimal(12, 6)
  withinTolerance         Boolean                   @default(true)
  unitCostSnapshot        Decimal                   @db.Decimal(20, 4)
  currency                String                    @default("KZT") @db.VarChar(3)
  componentCost           Decimal                   @default(0) @db.Decimal(20, 4)
  moisturePercent         Decimal                   @default(0) @db.Decimal(12, 6)
  absorptionPercent       Decimal                   @default(0) @db.Decimal(12, 6)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  allocations             BatchMaterialAllocation[]

  @@unique([batchId, materialId])
  @@index([batchId, withinTolerance])
  @@map("batch_components")
}

model BatchMaterialAllocation {
  id               String                    @id @default(uuid()) @db.Uuid
  batchComponentId String                    @db.Uuid
  batchComponent   BatchComponent            @relation(fields: [batchComponentId], references: [id], onDelete: Cascade)
  materialLotId    String                    @db.Uuid
  materialLot      MaterialLot               @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  reservedQuantity Decimal                   @default(0) @db.Decimal(20, 6)
  consumedQuantity Decimal                   @default(0) @db.Decimal(20, 6)
  returnedQuantity Decimal                   @default(0) @db.Decimal(20, 6)
  lossQuantity     Decimal                   @default(0) @db.Decimal(20, 6)
  unit             Unit
  unitCostSnapshot Decimal                   @db.Decimal(20, 4)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  productTrace     ProductLotMaterialTrace[]

  @@unique([batchComponentId, materialLotId])
  @@index([materialLotId])
  @@map("batch_material_allocations")
}

model MaterialMovement {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @db.Uuid
  materialLotId  String               @db.Uuid
  materialLot    MaterialLot          @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  batchId        String?              @db.Uuid
  batch          ProductionBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type           MaterialMovementType
  quantity       Decimal              @db.Decimal(20, 6)
  unit           Unit
  baseQuantity   Decimal              @db.Decimal(20, 6)
  baseUnit       Unit
  stockBefore    Decimal              @db.Decimal(20, 6)
  stockAfter     Decimal              @db.Decimal(20, 6)
