  reservedAfter  Decimal              @db.Decimal(20, 6)
  idempotencyKey String?
  reason         String?
  metadata       Json?
  occurredAt     DateTime             @default(now())

  @@index([workspaceId, materialLotId, occurredAt])
  @@index([workspaceId, batchId, occurredAt])
  @@index([workspaceId, idempotencyKey])
  @@map("material_movements")
}

model ProductLot {
  id                    String                    @id @default(uuid()) @db.Uuid
  workspaceId           String                    @db.Uuid
  workspace             Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchId               String                    @db.Uuid
  batch                 ProductionBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  number                String
  concreteGrade         String
  status                ProductLotStatus          @default(AVAILABLE)
  producedQuantity      Decimal                   @db.Decimal(20, 6)
  goodQuantity          Decimal                   @db.Decimal(20, 6)
  rejectedQuantity      Decimal                   @default(0) @db.Decimal(20, 6)
  lossQuantity          Decimal                   @default(0) @db.Decimal(20, 6)
  sentToLrtQuantity     Decimal                   @default(0) @db.Decimal(20, 6)
  returnedQuantity      Decimal                   @default(0) @db.Decimal(20, 6)
  writtenOffQuantity    Decimal                   @default(0) @db.Decimal(20, 6)
