}

model LrtTransfer {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @db.Uuid
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  number              String
  status              LrtTransferStatus    @default(DRAFT)
  transferAt          DateTime
  senderId            String               @db.Uuid
  sender              User                 @relation("TransferSender", fields: [senderId], references: [id], onDelete: Restrict)
  customerId          String?              @db.Uuid
  customer            Customer?            @relation("CustomerTransfers", fields: [customerId], references: [id], onDelete: Restrict)
  receiverId          String?              @db.Uuid
  receiver            User?                @relation("TransferReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  receiverName        String?
  transport           String?
  comments            String?              @db.Text
  sentAt              DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               LrtTransferItem[]
  attachments         Attachment[]
  accountingDocuments AccountingDocument[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, transferAt])
  @@index([workspaceId, customerId, transferAt])
  @@map("lrt_transfers")
}

model LrtTransferItem {
  id                String            @id @default(uuid()) @db.Uuid
