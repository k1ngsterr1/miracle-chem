DATABASE_URL="postgresql://betonflow:betonflow_dev@localhost:5434/betonflow?schema=public"
API_PORT=4100
WEB_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:4100/api"
# Парольная авторизация CRM. В production задайте уникальный секрет не короче 32 символов.
AUTH_MODE="session"
AUTH_SESSION_SECRET="replace-with-a-long-random-session-secret"
# Нужен только при интеграции с доверенным корпоративным шлюзом.
INTERNAL_API_KEY=""
# Отдельный ключ только для исходящих запросов локального 1С Sync Agent (32+ символа).
ONE_C_SYNC_API_KEY="replace-with-a-long-random-one-c-agent-key"
# Утверждённая привязка к одной организации 1С; не генерируйте новые GUID вместо существующего mapping.
ONE_C_SYNC_WORKSPACE_ID="replace-with-approved-workspace-guid"
ONE_C_SYNC_SOURCE_INSTANCE_ID="replace-with-approved-source-instance-guid"
ONE_C_SYNC_ORGANIZATION_ID="replace-with-approved-organization-guid"
# Ключ AES-256-GCM для полного архива 1С: openssl rand -base64 32.
# Сохраните его отдельно от резервной копии PostgreSQL: без ключа архив не расшифровать.
ONE_C_ARCHIVE_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
RATE_LIMIT_MAX=600
# Локальное защищённое хранилище чеков и других вложений API.
UPLOAD_STORAGE_DIR="./storage"
# Используется только при первоначальном seed локальной базы.
DEFAULT_ADMIN_PASSWORD="replace-with-a-strong-local-password"
